# ================================================================
# ObjetosIA Colombia - variables de entorno del backend
# Copia este archivo como .env (local) o define cada variable en el
# panel "Environment" de Render. Nunca subas el .env real a GitHub.
# ================================================================

# Puerto del servidor
PORT=5000

# "production" en Render. Activa las comprobaciones de seguridad al
# arrancar (JWT_SECRET fuerte, CLIENT_URL obligatoria) y oculta los
# detalles de errores internos.
NODE_ENV=development

# Conexion a MongoDB (local o Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/objetos_perdidos_ia

# ---------------- Sesiones (JWT) ----------------
# Clave secreta de minimo 32 caracteres aleatorios. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En produccion el servidor NO arranca si es corta o falta.
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_de_al_menos_32_caracteres
# Duracion de la sesion (antes 7d; ahora 8 horas por seguridad)
JWT_EXPIRES_IN=8h

# ---------------- Proteccion contra fuerza bruta ----------------
# Intentos fallidos de contraseña antes de bloquear la cuenta y minutos de bloqueo
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------------- Codigo OTP por correo ----------------
# Secreto para firmar (HMAC) los codigos. Si falta se usa JWT_SECRET,
# pero se recomienda uno distinto. Generalo igual que JWT_SECRET.
OTP_SECRET=
# always = todos los usuarios validan un codigo al iniciar sesion
# privileged = solo administradores e instituciones
# off = desactivado (solo para pruebas locales)
OTP_LOGIN_MODE=always
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_WINDOW=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------------- Recuperacion de contraseña ----------------
# Vigencia del enlace en minutos (se limita automaticamente a 15-60)
RESET_TOKEN_TTL_MINUTES=30

# ---------------- Correo SMTP (OBLIGATORIO para OTP y recuperacion) ----------------
# Con Gmail: activa la verificacion en 2 pasos y crea una "contraseña de
# aplicacion" (https://myaccount.google.com/apppasswords). Usala en
# EMAIL_PASS, NO tu contraseña normal.
# Puerto 587 -> EMAIL_SECURE=false (STARTTLS). Puerto 465 -> EMAIL_SECURE=true.
# Prueba la configuracion con:  npm run check:email -- tu_correo@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=ObjetosIA Colombia <tu_correo@gmail.com>
# SOLO desarrollo local: true imprime los correos en la consola en vez de
# enviarlos. Se ignora siempre con NODE_ENV=production.
EMAIL_DEV_FALLBACK=false

# ---------------- CORS / enlaces ----------------
# URL(es) del frontend permitidas, separadas por coma, sin "/" al final.
# Tambien se usa para construir el enlace de "olvide mi contraseña".
# Obligatoria con NODE_ENV=production.
#   Backend  (Render):       https://practica-nhtf.onrender.com
#   Frontend (InfinityFree): https://vblancor.great-site.net
CLIENT_URL=https://vblancor.great-site.net

# Numero de proxies delante del servidor (Render usa 1). Necesario para que
# el rate limiting vea la IP real del usuario. Por defecto 1 en produccion.
TRUST_PROXY=1

# ---------------- Limites por IP/usuario (opcionales) ----------------
# RL_API_MAX=600          # peticiones a /api cada 15 min por IP
# RL_LOGIN_MAX=10         # intentos de login cada 15 min por IP+correo
# RL_OTP_VERIFY_MAX=20
# RL_OTP_SEND_MAX=5
# RL_RESET_MAX=5          # solicitudes de recuperacion cada 15 min
# RL_REGISTER_MAX=10      # registros por hora por IP
# RL_REPORT_MAX=10        # reportes por hora por usuario
# RL_MESSAGE_MAX=15       # mensajes por minuto por usuario
# CHAT_MAX_UNANSWERED=10  # mensajes seguidos sin respuesta de la otra persona

# ---------------- Datos iniciales (npm run seed) ----------------
# Obligatorios en produccion. Usa correos REALES: el inicio de sesion
# pide un codigo OTP que llega a ese buzon.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_INSTITUTION_EMAIL=
SEED_INSTITUTION_PASSWORD=

# NOTA: MATCH_THRESHOLD ya NO se usa. La regla de negocio es fija:
# una coincidencia es valida solo si supera el 70 % (71 % si, 70 % no).
# Si la tienes definida en Render, eliminala (el servidor muestra un aviso).